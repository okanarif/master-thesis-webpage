{#- Photo with numbered markers positioned by percentage, plus a matching list. Labels stay text. -#}
{% macro callout_photo(m) -%}
<div class="callout">
  <figure class="callout__figure">
    <picture>
      {% if m.webp %}<source type="image/webp" srcset="{{ m.webp }}">{% endif %}
      <img src="{{ m.src }}" alt="{{ m.alt }}" width="{{ m.width }}" height="{{ m.height }}" loading="lazy" decoding="async">
    </picture>
    {%- for c in m.callouts %}
    <span class="callout__marker" style="--x:{{ c.x }}%;--y:{{ c.y }}%" aria-hidden="true">{{ loop.index }}</span>
    {%- endfor %}
  </figure>
  <ol class="callout__list">
    {%- for c in m.callouts %}
    <li><span class="callout__num" aria-hidden="true">{{ loop.index }}</span>{{ c.label }}</li>
    {%- endfor %}
  </ol>
</div>
{%- endmacro %}
