# ─────────────────────────────────────────────────────────────────────────────
# master-thesis-webpage — .gitignore
# Public repo. Only the website source and its small, web-optimized assets are
# tracked. Raw media, the thesis PDFs and all planning documents stay local.
# ─────────────────────────────────────────────────────────────────────────────

# ── Never published ──────────────────────────────────────────────────────────
Media/
Planning_Documents/

# Safety net: raw/large media anywhere in the tree, unless it is an explicitly
# web-optimized asset under assets/ (re-included below).
*.mp4
*.mov
*.MOV
*.mkv
*.avi
*.webm
*.gif
*.pdf
*.bag
*.mcap
*.db3
*.pptx
*.psd
*.blend
!assets/**/*.mp4
!assets/**/*.webm
!assets/**/*.pdf

# ── Build output (generated by tools/build.py, deployed by GitHub Actions) ──
dist/
_site/
.cache/

# ── Python tooling ───────────────────────────────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node (only if a JS toolchain is ever added) ──────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*

# ── Editors / OS ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Local secrets / env / scratch ────────────────────────────────────────────
.env
.env.*
*.log
tmp/
scratch/
